{
  "version": 1,
  "name": "bloom",
  "config": { "aspect": [1, 1], "seed": 8 },
  "nodes": [
    { "id": "n1", "kind": "builtin", "word": "circle", "x": 40, "y": 60,
      "inputs": { "x": { "value": 50 }, "y": { "value": 50 }, "r": { "value": 10 } } },
    { "id": "n2", "kind": "builtin", "word": "t.sample", "x": 300, "y": 60,
      "inputs": { "shape": { "from": ["n1", "out"] }, "count": { "value": 40 } } },
    { "id": "n3", "kind": "builtin", "word": "circle", "x": 40, "y": 243,
      "inputs": { "x": { "value": 50 }, "y": { "value": 50 }, "r": { "value": 44 } } },
    { "id": "n4", "kind": "builtin", "word": "t.material", "x": 300, "y": 200,
      "inputs": { "args": { "from": ["n3", "out"] } } },
    { "id": "n5", "kind": "code", "x": 560, "y": 120,
      "inputs": {
        "ring": { "type": "material", "from": ["n2", "out"] },
        "dish": { "type": "material", "from": ["n4", "out"] }
      },
      "outputs": { "grown": "material" },
      "body": "const grown = ring.steps(240, (cur, next) => {\n  const push = force.sum(\n    force.separation(cur, { radius: 3, excludeConnected: true }),\n    force.tension(cur, { rest: 1.2 }),\n    force.relax(cur, { amount: 0.6 }),\n    force.boundary(dish, { radius: 8 }),\n  );\n  next.move(cur.points, (p) => mul(push(p), 0.2));\n  const room = cur.edges.filter((e) => {\n    const own = new Set([e.a.index, e.b.index, ...e.a.adjacent.indices, ...e.b.adjacent.indices]);\n    return cur.points.near(mul(add(e.a, e.b), 0.5), { radius: 2.5 }).every((q) => own.has(q.index));\n  });\n  next.splitEdges(room.filter(() => t.chance(0.3)));\n}, { every: 40 });\nreturn { grown };"
    },
    { "id": "n6", "kind": "code", "x": 560, "y": 714,
      "inputs": { "grown": { "type": "material", "from": ["n5", "grown"] } },
      "outputs": { "rings": "drawing" },
      "body": "const rings = grown.history.slice(1, -1).map((h) => strokes(h.material, { pen: 'pigma-005-black' }));\nreturn { rings };"
    },
    { "id": "n7", "kind": "builtin", "word": "mm", "x": 560, "y": 952,
      "inputs": { "n": { "value": 1.1 } } },
    { "id": "n8", "kind": "code", "x": 860, "y": 200,
      "inputs": {
        "grown": { "type": "material", "from": ["n5", "grown"] },
        "rings": { "type": "drawing", "from": ["n6", "rings"] },
        "spacing": { "type": "Number", "from": ["n7", "out"] }
      },
      "outputs": { "ink": "drawing" },
      "body": "return { ink: [polygon(grown, { opaque: true, fill: fill('hatch', { angle: 60, spacing }), pen: 'pigma-05-black' }), rings] };"
    },
    { "id": "v1", "kind": "viewer", "x": 300, "y": 340, "inputs": { "in": { "from": ["n2", "out"] } } },
    { "id": "v2", "kind": "viewer", "x": 40, "y": 426, "inputs": { "in": { "from": ["n1", "out"] } } },
    { "id": "v3", "kind": "viewer", "x": 300, "y": 604, "inputs": { "in": { "from": ["n4", "out"] } } },
    { "id": "v4", "kind": "viewer", "x": 860, "y": 483, "inputs": { "in": { "from": ["n5", "grown"] } } },
    { "id": "v5", "kind": "viewer", "x": 860, "y": 747, "inputs": { "in": { "from": ["n6", "rings"] } } },
    { "id": "v6", "kind": "viewer", "x": 1160, "y": 300, "inputs": { "in": { "from": ["n8", "ink"] } } },
    { "id": "n9", "kind": "output", "x": 1160, "y": 120, "inputs": { "in": { "from": ["n8", "ink"] } } }
  ]
}
