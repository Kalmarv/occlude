{
  "name": "occlude",
  "version": "0.1.0",
  "description": "A drawing library for pen plotters where fill means fill",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "render": "tsx tools/render-png.ts",
    "build": "tsc -p tsconfig.json",
    "qa": "tsx tools/qa-sweep.ts",
    "bench": "tsx bench/all.mts",
    "calibrate": "tsx tools/calibrate.ts",
    "frags": "tsx tools/frags.ts",
    "render-hash": "tsx tools/render-hash.ts",
    "growth-diag": "tsx tools/growth-diag.ts",
    "plotstats": "tsx tools/plotstats.ts",
    "docs:check": "tsx tools/check-docs-examples.ts",
    "dump-scene": "tsx tools/dump-scene.ts",
    "renderhash": "tsx tools/renderhash.ts",
    "docs:hashes": "tsx tools/docs-hashes.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "store-sweep": "tsx tools/store-sweep.ts"
  },
  "dependencies": {
    "clipper-lib": "6.4.2",
    "commons-math-interpolation": "^2.2.4",
    "d3-delaunay": "^6.0.4",
    "occlude-core": "link:../../crates/occlude-core/pkg",
    "robust-predicates": "3.0.3"
  },
  "devDependencies": {
    "@types/clipper-lib": "^6.4.0",
    "@types/d3-delaunay": "^6.0.4",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.24.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
