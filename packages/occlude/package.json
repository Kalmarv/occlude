{
  "name": "occlude",
  "version": "0.1.0",
  "description": "A drawing library for pen plotters where fill means fill",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "render": "tsx tools/render-png.ts",
    "build": "tsc -p tsconfig.json",
    "qa": "tsx tools/qa-sweep.ts",
    "calibrate": "tsx tools/calibrate.ts",
    "plotstats": "tsx tools/plotstats.ts",
    "docs:check": "tsx tools/check-docs-examples.ts"
  },
  "dependencies": {
    "occlude-core": "link:../../crates/occlude-core/pkg"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.24.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}